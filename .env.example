# Copy this file to .env.local and fill in real values from your Supabase
# project (Project Settings -> API). Never commit .env.local — it's gitignored.
#
# Only the anon key belongs here. It is safe to ship to the browser: every
# table it can touch is protected by Row Level Security (see
# supabase/schema.sql), so the anon key alone can never read or write another
# user's data. The service_role key must NEVER appear in frontend code or in
# any file that gets committed.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Deliberately NOT VITE_-prefixed — Vite only bundles VITE_-prefixed vars into
# the client build, so this one is invisible to the browser as long as it
# stays named exactly this. Only used by scripts/seed-skills-to-supabase.mjs,
# run manually from your terminal (`node scripts/seed-skills-to-supabase.mjs`),
# never imported by any frontend code. Find it in Supabase Dashboard ->
# Project Settings -> API -> service_role (the "secret" key, not "anon").
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

